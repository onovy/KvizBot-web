<?php

// Absolute path to the web root directory (without trailing /)
$local_config['web_dir']='/var/www/html';

// Web base URL (without trailing /)
$local_config['web_www']='http://www.xkviz.net';

// Verbose
// 1 -- checks everything possible and prints warnings
// 2 -- prints debug information
$local_config['verbose']=0;

// PHP error reporting level
$local_config['error_reporting']=E_ALL & ~E_NOTICE;

// Redirect to prefix (empty string means NEVER redirect)
$local_config['http_redir_with_prefix']='www.';

// Database settings
$local_config['sql_name']='xkviz';
$local_config['sql_user']='xkviz';
$local_config['sql_pass']='';
$local_config['sql_host']='localhost';
$local_config['sql_charset']='utf8mb4';

// Smarty settings
$local_config['compile_check']=true;

// Cache settings
$local_config['use_cache']=true;
